#!/bin/bash
# Aggregate traffic counters rather than binding a trigger to one NIC.
set -euo pipefail

# Keep the process lock open; another invocation must never remove our lock.
exec 9>"${UGREEN_RUN_ROOT:-/run}/ugreen-netdevmon-multi.lock"
flock -n 9 || { echo 'ugreen-netdevmon-multi already running' >&2; exit 1; }
config_root=${UGREEN_CONFIG_ROOT:-/etc}
if [[ -f "$config_root/ugreen-leds/network.conf" ]]; then
    source "$config_root/ugreen-leds/network.conf"
fi
if [[ -f "$config_root/ugreen-leds.conf" ]]; then
    source "$config_root/ugreen-leds.conf"
fi

# Roots are overridable to exercise counter handling without LED hardware.
net_root=${UGREEN_NET_ROOT:-/sys/class/net}
led_root=${UGREEN_LED_ROOT:-/sys/class/leds/netdev}
mode=${NETWORK_MODE:-all}
selected=${NETWORK_INTERFACES:-}
interval=${NETDEV_POLL_INTERVAL:-0.1}
[[ -d "$led_root" ]] || { echo "Network LED not found: $led_root" >&2; exit 1; }
if [[ "$led_root" = /sys/* ]]; then
    modprobe ledtrig-oneshot
fi
printf 'oneshot\n' > "$led_root/trigger"
printf '%s\n' "${LED_INVERT:-0}" > "$led_root/invert"
printf '%s\n' "${NETDEV_BLINK_INTERVAL:-200}" > "$led_root/delay_on"
printf '%s\n' "${NETDEV_BLINK_INTERVAL:-200}" > "$led_root/delay_off"
printf '%s\n' "${BRIGHTNESS_NETDEV_LED:-255}" > "$led_root/brightness"
printf '%s\n' "${COLOR_NETDEV_NORMAL:-255 165 0}" > "$led_root/color"

get_interfaces() {
    local path iface
    if [[ -n "$selected" && "$mode" != all ]]; then
        for iface in $selected; do
            [[ "$iface" =~ ^[a-zA-Z0-9_.:-]+$ ]] || continue
            if [[ -d "$net_root/$iface" ]]; then
                printf '%s\n' "$iface"
                if [[ "$mode" = single ]]; then break; fi
            fi
        done
    else
        for path in "$net_root"/*; do
            [[ -e "$path/device" && -r "$path/type" ]] || continue
            [[ $(<"$path/type") = 1 ]] || continue
            printf '%s\n' "${path##*/}"
            if [[ "$mode" = single ]]; then break; fi
        done
    fi
}

set_color() {
    local speed=$1 color=${COLOR_NETDEV_NORMAL:-255 165 0}
    if [[ ${CHECK_LINK_SPEED_DYNAMIC:-false} = true ]]; then
        color=$(awk -v speed="$speed" \
            -v low="${CHECK_LINK_SPEED_DYNAMIC_SPEED_LOW:-0}" \
            -v high="${CHECK_LINK_SPEED_DYNAMIC_SPEED_HIGH:-10000}" \
            -v lc="${CHECK_LINK_SPEED_DYNAMIC_COLOR_LOW:-255 0 0}" \
            -v hc="${CHECK_LINK_SPEED_DYNAMIC_COLOR_HIGH:-0 255 0}" '
            BEGIN {
                split(lc, l, " "); split(hc, h, " ");
                r = high > low ? (speed-low)/(high-low) : 0;
                r = r < 0 ? 0 : (r > 1 ? 1 : r);
                printf "%.0f %.0f %.0f", l[1]+r*(h[1]-l[1]), l[2]+r*(h[2]-l[2]), l[3]+r*(h[3]-l[3]);
            }')
    elif [[ ${CHECK_LINK_SPEED:-false} = true ]]; then
        case "$speed" in
            100) color=${COLOR_NETDEV_LINK_100:-0 255 0} ;;
            1000) color=${COLOR_NETDEV_LINK_1000:-0 0 255} ;;
            2500) color=${COLOR_NETDEV_LINK_2500:-255 255 0} ;;
            10000) color=${COLOR_NETDEV_LINK_10000:-255 255 255} ;;
        esac
    fi
    printf '%s\n' "$color" > "$led_root/color"
}

declare -A previous_rx previous_tx
last_color=-100000
while true; do
    mapfile -t interfaces < <(get_interfaces)
    declare -A present=()
    activity=false
    max_speed=0
    for iface in "${interfaces[@]}"; do
        present[$iface]=1
        rx=$(cat "$net_root/$iface/statistics/rx_bytes" 2>/dev/null) || continue
        tx=$(cat "$net_root/$iface/statistics/tx_bytes" 2>/dev/null) || continue
        [[ "$rx" =~ ^[0-9]+$ && "$tx" =~ ^[0-9]+$ ]] || continue
        # A counter reset/hotplug establishes a new baseline, not activity.
        if [[ ${NETDEV_BLINK_RX:-1} = 1 && -v previous_rx[$iface] ]] && ((rx > previous_rx[$iface])); then activity=true; fi
        if [[ ${NETDEV_BLINK_TX:-1} = 1 && -v previous_tx[$iface] ]] && ((tx > previous_tx[$iface])); then activity=true; fi
        previous_rx[$iface]=$rx
        previous_tx[$iface]=$tx
        speed=$(cat "$net_root/$iface/speed" 2>/dev/null) || speed=0
        if [[ "$speed" =~ ^[0-9]+$ ]] && ((speed > max_speed)); then max_speed=$speed; fi
    done
    for iface in "${!previous_rx[@]}"; do
        if [[ ! -v present[$iface] ]]; then
            unset 'previous_rx[$iface]' 'previous_tx[$iface]'
        fi
    done
    if $activity; then printf '1\n' > "$led_root/shot"; fi
    if ((SECONDS - last_color >= ${CHECK_NETDEV_INTERVAL:-60})); then
        set_color "$max_speed"
        last_color=$SECONDS
    fi
    sleep "$interval"
done
