#!/bin/sh
set -e
if [ "$1" = remove ] && [ -d /run/systemd/system ]; then
    deb-systemd-invoke stop ugreen-netdevmon-multi.service ugreen-diskiomon.service \
        ugreen-power-led.service ugreen-probe-leds.service || true
    # Template instances may have been enabled manually or by older packages.
    deb-systemd-invoke stop 'ugreen-netdevmon@*.service' || true
fi
#DEBHELPER#
